# SmartAttend Backend Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
PORT=5000

# Secret keys
SECRET_KEY=smartattend-super-secret-key-change-in-production-2025
JWT_SECRET_KEY=smartattend-jwt-secret-key-change-in-production-2025
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Supabase PostgreSQL Database (Enforced as the sole database)
# Recommended for Vercel / Serverless (IPv4 Pooler URI):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Direct connection (IPv6 only - fails on Vercel AWS Lambda):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Project API Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Institutional Email & Allowed Domains (MIT AOE: PRN format 202501100063@mitaoe.ac.in)
ALLOWED_EMAIL_DOMAINS=mitaoe.ac.in
FRONTEND_URL=http://localhost:5173

# SMTP Email Verification Configuration (via Supabase custom SMTP or institutional SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@institution.edu
MAIL_PASSWORD=your-secure-app-password
MAIL_DEFAULT_SENDER=SmartAttend <noreply@institution.edu>

# Attendance Thresholds
MIN_ATTENDANCE_WARNING_THRESHOLD=75.0
EXCELLENT_ATTENDANCE_THRESHOLD=85.0
